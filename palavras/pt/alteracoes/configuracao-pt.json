{
  // Português: uma língua de jogo, duas variantes (bit 0 = PT, bit 1 = BR)
  "code": "pt",
  "name": "Português",
  // K, W e Y ficam de fora: aparecem em menos de 0,05% das palavras (estrangeirismos)
  "alphabet": "ABCDEFGHIJLMNOPQRSTUVXZÇ",
  "fold": {
    "á": "a", "à": "a", "â": "a", "ã": "a",
    "é": "e", "ê": "e", "è": "e",
    "í": "i", "ì": "i",
    "ó": "o", "ô": "o", "õ": "o", "ò": "o",
    "ú": "u", "ù": "u", "ü": "u"
  },
  "minLength": 2,
  // Palavras sem vogal são siglas/unidades (CM, ML, SR, XV): excluídas
  "vowels": "AEIOU",
  "maxLength": 15,
  "tileTotal": 100,
  "blanks": 2,
  // Peças afinadas com o TileTuner (2026-10-08): quantidades perto da frequência do dicionário,
  // menos um pouco de A (menos suportes AAA); valores pela raridade + dificuldade medida em
  // 3000 partidas simuladas (quanto tempo a letra fica no suporte e quantas vezes sobra no fim).
  "tiles": [
    { "letter": "A", "count": 15, "value":  1 },
    { "letter": "B", "count":  2, "value":  4 },
    { "letter": "C", "count":  4, "value":  3 },
    { "letter": "D", "count":  3, "value":  2 },
    { "letter": "E", "count": 11, "value":  1 },
    { "letter": "F", "count":  1, "value":  4 },
    { "letter": "G", "count":  1, "value":  4 },
    { "letter": "H", "count":  1, "value":  6 },
    { "letter": "I", "count":  9, "value":  1 },
    { "letter": "J", "count":  1, "value":  6 },
    { "letter": "L", "count":  3, "value":  2 },
    { "letter": "M", "count":  4, "value":  2 },
    { "letter": "N", "count":  4, "value":  3 },
    { "letter": "O", "count":  8, "value":  1 },
    { "letter": "P", "count":  2, "value":  3 },
    { "letter": "Q", "count":  1, "value": 10 },
    { "letter": "R", "count":  7, "value":  1 },
    { "letter": "S", "count":  8, "value":  1 },
    { "letter": "T", "count":  4, "value":  2 },
    { "letter": "U", "count":  5, "value":  2 },
    { "letter": "V", "count":  1, "value":  3 },
    { "letter": "X", "count":  1, "value":  8 },
    { "letter": "Z", "count":  1, "value":  6 },
    { "letter": "Ç", "count":  1, "value":  8 }
  ],
  "blocklist": "pt.blocklist.txt",
  "allowlist": "pt.allowlist.txt",
  "variants": [
    {
      "id": "PT", "name": "Português (Portugal)",
      "sources": [ {
        "aff": "../sources/pt_PT/pt_PT.aff", "dic": "../sources/pt_PT/pt_PT.dic",
        "credit": "Dicionário pt_PT do Projecto Natura (J. J. Almeida, R. Vilela, A. Simões — Universidade do Minho)",
        "license": "MPL 1.1 (escolhida entre GPL 2 / LGPL 2.1 / MPL 1.1)",
        "url": "https://natura.di.uminho.pt",
        // Marcas na morfologia do dicionário: abreviaturas, numeração romana, pontuação e
        // estrangeirismos (ORIG=ing/fra/lat/jap...). Saem de TODAS as variantes.
        "excludeMorph": [ "ABR=1", "subcat=rom", "CAT=punct", "ORIG=" ]
      } ]
    },
    {
      "id": "BR", "name": "Português (Brasil)",
      "sources": [ {
        "aff": "../sources/pt_BR/pt_BR.aff", "dic": "../sources/pt_BR/pt_BR.dic",
        "credit": "VERO — Verificador Ortográfico do LibreOffice (Raimundo Moura e equipa)",
        "license": "MPL (escolhida entre LGPL 3 / MPL)",
        "url": "https://pt-br.libreoffice.org/projetos/projeto-vero-verificador-ortografico/",
        "skipNoSuggest": true,
        "dropRules": [
          { "flags": "abcdefghiwtu", "add": "mo$", "reason": "Radicais de ênclise/mesóclise (amaremo-nos -> 'amaremo'), não são palavras isoladas" },
          { "flags": "j", "add": "(mente|inh[oa]s?|ão|ões|onas?)$", "reason": "Aumentativos/diminutivos/advérbios de nomes de agente (aquinhoadorzão)" },
          { "flags": "L", "add": "", "reason": "Graus de particípios (amadão, amadona, amadamente)" },
          { "flags": "VW6", "add": "", "reason": "Aumentativos gerados para qualquer nome (afurololzão); os lexicalizados (casarão) são raízes próprias" }
        ]
      } ]
    }
  ]
}
